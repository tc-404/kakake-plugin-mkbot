{
  "name": "napcat-plugin-mkbot",
  "plugin": "MKbot",
  "version": "2.3.9",
  "type": "module",
  "main": "index.mjs",
  "description": "MKbot - 综合娱乐和群管",
  "author": "三个句号",
  "license": "MIT",
  "homepage": "https://github.com/tc-404/napcat-plugin-mkbot",
  "webui": "webui/admin.html",
  "keywords": [
    "napcat",
    "plugin",
    "mkbot"
  ],
  "napcat": {
    "tags": [
      "娱乐",
      "群管"
    ],
    "minVersion": "4.17.10",
    "homepage": "https://github.com/tc-404/napcat-plugin-mkbot"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "fflate": "^0.8.2",
    "napcat-types": "0.0.16",
    "sharp": "^0.34.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@simonwep/pickr": "^1.9.1",
    "@types/node": "^20.19.33",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && vite build && node scripts/build-api.mjs && node scripts/build-sharp-worker.mjs && node scripts/verify-dist.mjs",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "verify:media-path": "node scripts/verify-media-path.mjs",
    "verify:download-timeout": "node scripts/verify-download-timeout.mjs",
    "verify:list-cache": "node scripts/verify-list-cache.mjs",
    "verify:leave-blacklist": "node scripts/verify-leave-blacklist.mjs"
  }
}
